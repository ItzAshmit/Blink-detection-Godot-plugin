; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Eye_Detection_plugin"
run/main_scene="res://addons/Eye Detection/Example Scene/example.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"

[dotnet]

project/assembly_name="Eye_Detection_plugin_lite"

[editor]

movie_writer/movie_file="C:/Users/hp/Work/Godot/Others/Blink-detection Godot plugin/eye_detection_plugin/Vids/clip4.avi"

[editor_plugins]

enabled=PackedStringArray("res://addons/Eye Detection/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
